/* Kopie als web/config.local.js ablegen und anpassen (wird nicht ins Repository übernommen). */
window.APP_CONFIG.LASTFM_KEY = 'DEIN_LASTFM_SCHLUESSEL';
/* Scrobbeln (Verlauf): "Shared secret" von https://www.last.fm/api/accounts:
window.APP_CONFIG.LASTFM_SECRET = 'DEIN_SHARED_SECRET';
*/
/* Sprache fest einstellen (sonst nach der Gerätesprache); eigene Sprachdatei web/lang/fr.js zusätzlich anmelden:
window.APP_CONFIG.LANGUAGE = 'en';
window.APP_CONFIG.LANGUAGES = ['de', 'en', 'fr'];
*/
/* Immer hell oder immer dunkel (sonst wie das Gerät):
window.APP_CONFIG.THEME = 'light';
*/
/* Rotel-Verstärker (rotel/rotel-bridge.js liest die Adresse aus dieser Datei; danach den Dienst neu starten):
window.APP_CONFIG.ROTEL = true;
window.APP_CONFIG.ROTEL_HOST = '192.168.1.50';
*/
/* Teile einzelner Streamingdienste abschalten, auch wenn das Plugin läuft:
window.APP_CONFIG.TIDAL = false;
window.APP_CONFIG.QOBUZ = false;
window.APP_CONFIG.HRA = false;
window.APP_CONFIG.SPOTIFY = false;
*/
